{
  "manifest_version": 3,
  "name": "抖音私信下载器",
  "version": "1.0.0",
  "description": "在抖音网页版下载与某个用户的完整聊天记录，导出为 HTML / TXT。",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://*.douyin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "抖音私信下载器"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://*.douyin.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://*.douyin.com/*"]
    }
  ]
}
